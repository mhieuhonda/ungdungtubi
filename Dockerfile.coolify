# syntax=docker/dockerfile:1.7
# ────────────────────────────────────────────────────────────────────────────
# Dockerfile.coolify — Pull pre-built image từ GHCR (CI/CD v0.9.4+)
#
# Coolify v4.1.2 API chỉ cho phép build_pack ∈ {dockerfile, nixpacks} — không
# cho phép set "dockerimage" qua API. Workaround: dùng một Dockerfile tối giản
# chỉ chứa `FROM <prebuilt-image>`. Coolify clone repo, "build" Dockerfile này
# (chỉ là pull image), rồi deploy.
#
# Image thật được build bởi GitHub Actions (xem ./Dockerfile) và push lên
# ghcr.io/mhieuhonda/tubi-app. Coolify chỉ pull image đó, không build từ source.
#
# [v0.9.5] Reference specific sha tag thay vì :latest để đảm bảo Coolify pull
# đúng image mới nhất (tránh Docker daemon cache stale digest khi :latest
# chưa propagate ngay sau GitHub Actions push).
#
# [v0.9.11] CRITICAL FIX: Lỗi production vẫn chạy v0.9.9 dù v0.9.10 đã push
# lên GHCR là do Docker daemon cache stale digest khi dùng `:latest`.
# Giải pháp: dùng tag semver `:0.9.11` thay vì `:latest`. Mỗi release mới có
# tag semver riêng → Docker chắc chắn pull image mới (tag chưa tồn tại trong
# cache).
#
# Lợi ích:
#   - Không tốn CPU/RAM VPS để build Rust (build trên GitHub-hosted runner)
#   - Deploy nhanh (~10-30s pull + restart)
#   - Rollback dễ: đổi tag sang `:sha-<old>` hoặc `:v0.9.10`
#   - [v0.9.11] Tránh Docker cache stale digest bằng tag semver unique
# ────────────────────────────────────────────────────────────────────────────

# v0.9.35 — Giai đoạn 40: Nhạc Cộng Đồng (YouTube submissions, admin approval, Game cleanup)
# v0.9.26 FIX (CRITICAL — Deploy pipeline): Workflow GitHub Actions sẽ TỰ ĐỘNG cập nhật
# SHA tag dưới đây ngay sau khi build image xong, trước khi trigger Coolify deploy.
# Trước v0.9.26: developer phải push 2 commit (code commit + Dockerfile.coolify update commit)
# → dễ quên bước 2 → Coolify deploy old code → "deploy thành công nhưng production không đổi".
# Giờ v0.9.26: chỉ cần push 1 commit code, workflow tự lo phần còn lại.
FROM ghcr.io/mhieuhonda/tubi-app:sha-8a494bb
