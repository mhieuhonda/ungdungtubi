# ============================================================
# Ứng Dụng Từ Bi — Environment Configuration (v0.3)
# Copy file này thành .env và điền giá trị thực
# ============================================================

# --- App ---
APP_ENV=development          # development | production
HOST=0.0.0.0
PORT=8080
DOMAIN=tubi.louis.vangioitutien.com
APP_BASE_URL=http://localhost:8080
# Production: APP_BASE_URL=https://tubi.louis.vangioitutien.com

# SECRET_KEY dùng cho session signing — PHẢI đặt trong production
SECRET_KEY=ung-dung-tu-bi-dev-secret-key

# --- Database ---
DATABASE_URL=postgres://tubi:tubi_password@localhost:5432/ungdungtubi

# --- Google OAuth ---
# Lấy từ Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# KHÔNG commit .env thật — chỉ điền giá trị vào file .env local của bạn
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redirect URI đã đăng ký trong Google Cloud Console (Authorized redirect URIs)
# Phải khớp chính xác với giá trị trong Google Console
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback
# Production: GOOGLE_REDIRECT_URI=https://tubi.louis.vangioitutien.com/auth/google/callback

# --- Logging ---
RUST_LOG=ungdungtubi=info,actix_web=info,sqlx=warn
