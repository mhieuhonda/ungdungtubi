# ============================================================
# Ứng Dụng Từ Bi — Environment Configuration (v0.5)
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit .env — chỉ điền giá trị vào file .env local của bạn
# ============================================================

# --- App ---
APP_ENV=development          # development | production
HOST=0.0.0.0
PORT=8080
DOMAIN=tubi.louis.vangioitutien.com
APP_BASE_URL=http://localhost:8080
# Production: APP_BASE_URL=https://tubi.louis.vangioitutien.com

# SECRET_KEY dùng cho session signing — PHẢI đặt trong production
SECRET_KEY=ung-dung-tu-bi-dev-secret-key

# --- Database (PostgreSQL 17) ---
# Local dev:
DATABASE_URL=postgres://tubi:tubi_password@localhost:5432/ungdungtubi
# Production (sub VPS 10.187.247.3):
# DATABASE_URL=postgres://tubi:<password>@10.187.247.3:5432/ungdungtubi

# DB pool size (mặc định 10, tăng nếu cần)
DB_MAX_CONNECTIONS=10

# --- Static files & uploads ---
# Trong Docker: STATIC_DIR=/app/static, UPLOAD_DIR=/app/static/uploads
# Local dev: bỏ trống để dùng mặc định (src/static)
STATIC_DIR=
UPLOAD_DIR=
UPLOAD_URL_PREFIX=/static/uploads
# Max upload size per file (bytes) — mặc định 5 MB
MAX_UPLOAD_BYTES=5242880

# --- Google OAuth ---
# Lấy từ Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Đây là phương thức đăng nhập/đăng ký duy nhất của Ứng Dụng Từ Bi
GOOGLE_CLIENT_ID=981617351564-lrgfkopuciqlf42hoe2ib40d3b72ic8n.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# Redirect URI đã đăng ký trong Google Cloud Console (Authorized redirect URIs)
# Phải khớp chính xác với giá trị trong Google Console
GOOGLE_REDIRECT_URI=https://tubi.louis.vangioitutien.com/auth/google/callback

# --- Migrations ---
# Set true để auto-run migrations khi khởi động (mặc định true nếu APP_ENV=production)
RUN_MIGRATIONS=true

# --- Logging ---
RUST_LOG=ungdungtubi=info,axum=info,tower_http=info,sqlx=warn
